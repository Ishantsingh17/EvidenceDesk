# EvidenceDesk AI backend configuration.
# Copy to backend/.env and fill in values. Never commit backend/.env.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Groq is used for LLM inference only. Keep the key in backend/.env only.
GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_ATTEMPTS=3
GROQ_RETRY_BASE_SECONDS=1
GROQ_MAX_RETRY_WAIT_SECONDS=15

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
MIN_PAGE_TEXT_CHARS=30
RETRIEVAL_TOP_K=4
RETRIEVAL_TOP_K_MAX=10
# Blank until calibrated against the labelled dataset (D-24).
RETRIEVAL_MAX_DISTANCE=
QUERY_MAX_CHARS=1000

# Relative paths are resolved from the project root, not the working directory.
DATA_DIR=data
SQLITE_PATH=data/app.db
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=enterprise_document_chunks
EVALUATION_DATASET_DIR=evaluation/datasets
MAX_UPLOAD_SIZE_MB=20
SSE_HEARTBEAT_SECONDS=15
